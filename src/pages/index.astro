---
import UploadArea from '../components/UploadArea.astro'
import CameraViewfinder from '../components/CameraViewfinder.astro'
import CameraPreview from '../components/CameraPreview.astro'
import AdjustmentPanel from '../components/AdjustmentPanel.astro'
import MosaicDisplay from '../components/MosaicDisplay.astro'
import ColorMatrix from '../components/ColorMatrix.astro'
import PartsList from '../components/PartsList.astro'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Faceplate — LEGO Mosaic Generator</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header>
      <div class="header-inner">
        <h1>Faceplate</h1>
        <p class="tagline">Turn any face into a LEGO mosaic</p>
        <a class="more-info" href="https://thronebuilder.com/blog/faceplate/" target="_blank" rel="noopener noreferrer">Learn more about this project ↗</a>
      </div>
    </header>

    <main>
      <UploadArea />
      <CameraViewfinder />
      <CameraPreview />

      <!-- Preparing indicator (US2 T029 — shown while EXIF + head detection runs) -->
      <div id="preparing-indicator" hidden>
        <div class="spinner" aria-hidden="true"></div>
        <span>Preparing image…</span>
      </div>

      <AdjustmentPanel />
      <MosaicDisplay />
      <ColorMatrix />
      <PartsList />
    </main>
  </body>
</html>

<script>
  import type { AppState, FaceImage, HeadCropSelection, AdjustedImage, Mosaic, CameraSession, CapturedPhoto } from '../types/index.js'
  import type { LegoColor } from '../types/index.js'
  import { applyAdjustments } from '../lib/image/adjust.js'
  import { validateFile } from '../lib/image/validate.js'
  import { generateMosaic } from '../lib/mosaic/pipeline.js'
  import { derivePartsList } from '../lib/mosaic/parts-list.js'
  import {
    onFileSelected, onFileValidated, onFileValidationError,
    onCameraSessionReady, onPhotoCaptured, onPhotoRetaken, onPhotoConfirmed, onCameraError,
    onAdjustmentChanged, onGenerateClicked, onGenerateSuccess, onReset,
  } from '../lib/app-state.js'
  import PALETTE_RAW from '../data/lego-palette.json'

  const palette: LegoColor[] = PALETTE_RAW as LegoColor[]

  // ─── State ───────────────────────────────────────────────────────────────────

  let appState: AppState = { phase: 'idle' }
  let activeStream: MediaStream | null = null
  let availableVideoDevices: MediaDeviceInfo[] = []
  let currentDeviceIndex = 0

  // ─── DOM references ───────────────────────────────────────────────────────────

  const uploadArea          = document.getElementById('upload-area')!
  const uploadInput         = document.getElementById('upload-input') as HTMLInputElement
  const uploadError         = document.getElementById('upload-error')!

  const cameraOption        = document.getElementById('camera-option')!
  const useCameraBtn        = document.getElementById('use-camera-btn') as HTMLButtonElement
  const cameraSwitchRow     = document.getElementById('camera-switch-row')!
  const switchCameraBtn     = document.getElementById('switch-camera-btn') as HTMLButtonElement
  const cancelCameraBtn     = document.getElementById('cancel-camera-btn') as HTMLButtonElement
  const cameraErrorMsg      = document.getElementById('camera-error-msg')!
  const uploadDivider       = document.getElementById('upload-divider')!

  const cameraViewfinder    = document.getElementById('camera-viewfinder')!
  const cameraVideo         = document.getElementById('camera-video') as HTMLVideoElement
  const captureBtn          = document.getElementById('capture-btn') as HTMLButtonElement

  const cameraPreview       = document.getElementById('camera-preview')!
  const previewImg          = document.getElementById('preview-img') as HTMLImageElement
  const confirmPhotoBtn     = document.getElementById('confirm-photo-btn') as HTMLButtonElement
  const retakeBtn           = document.getElementById('retake-btn') as HTMLButtonElement

  const preparingIndicator  = document.getElementById('preparing-indicator')!

  const adjustmentPanel     = document.getElementById('adjustment-panel')!
  const previewCanvas       = document.getElementById('preview-canvas') as HTMLCanvasElement
  const brightnessSlider    = document.getElementById('brightness-slider') as HTMLInputElement
  const contrastSlider      = document.getElementById('contrast-slider') as HTMLInputElement
  const brightnessValue     = document.getElementById('brightness-value')!
  const contrastValue       = document.getElementById('contrast-value')!
  const generateBtn         = document.getElementById('generate-button') as HTMLButtonElement
  const recropBtn           = document.getElementById('recrop-button') as HTMLButtonElement
  const progressIndicator   = document.getElementById('progress-indicator')!

  const mosaicDisplay       = document.getElementById('mosaic-display')!
  const mosaicGrid          = document.getElementById('mosaic-grid')!
  const originalCanvas      = document.getElementById('original-canvas') as HTMLCanvasElement

  const colorMatrixSection  = document.getElementById('color-matrix-section')!
  const colorMatrixEl       = document.getElementById('color-matrix')!

  const partsListSection    = document.getElementById('parts-list-section')!
  const partsListEl         = document.getElementById('parts-list')!
  const totalPiecesEl       = document.getElementById('total-pieces')!

  // ─── Visibility ───────────────────────────────────────────────────────────────

  function show(el: HTMLElement) { el.hidden = false }
  function hide(el: HTMLElement) { el.hidden = true }

  function showError(el: HTMLElement, msg: string) { el.textContent = msg; el.hidden = false }
  function clearError(el: HTMLElement) { el.textContent = ''; el.hidden = true }

  function renderPhase(state: AppState) {
    hide(uploadArea); hide(cameraViewfinder); hide(cameraPreview)
    hide(preparingIndicator); hide(adjustmentPanel)
    hide(mosaicDisplay); hide(colorMatrixSection); hide(partsListSection)
    clearError(uploadError); clearError(cameraErrorMsg)

    switch (state.phase) {
      case 'idle':
      case 'uploading':
        show(uploadArea)
        break

      case 'upload-error':
        show(uploadArea)
        showError(uploadError, state.error)
        break

      case 'camera-viewfinder':
        show(cameraViewfinder)
        break

      case 'camera-preview':
        show(cameraPreview)
        break

      case 'camera-error':
        show(uploadArea)
        showError(cameraErrorMsg, state.error)
        break

      case 'preparing':
        show(preparingIndicator)
        break

      // head-cropping and head-crop-error handled by US2 (HeadCropTool)
      case 'head-cropping':
      case 'head-crop-error':
        show(preparingIndicator) // temporary placeholder until US2 wires HeadCropTool
        break

      case 'adjusting':
      case 'generating':
        show(adjustmentPanel)
        generateBtn.disabled = state.phase === 'generating'
        progressIndicator.hidden = state.phase !== 'generating'
        break

      case 'result':
        show(adjustmentPanel)
        show(mosaicDisplay)
        show(colorMatrixSection)
        show(partsListSection)
        generateBtn.disabled = false
        progressIndicator.hidden = true
        break
    }
  }

  // ─── Temporary bypass: full-image crop until US2 implements head detection ────
  // Replaced by US2's EXIF correction + MediaPipe head detection + HeadCropTool.

  async function prepareFullImageCrop(image: FaceImage): Promise<void> {
    return new Promise(resolve => {
      const img = new Image()
      img.onload = () => {
        const canvas = document.createElement('canvas')
        canvas.width  = img.naturalWidth
        canvas.height = img.naturalHeight
        canvas.getContext('2d')!.drawImage(img, 0, 0)
        const imageData = canvas.getContext('2d')!.getImageData(0, 0, canvas.width, canvas.height)
        const crop: HeadCropSelection = {
          topY: 0, bottomY: canvas.height,
          leftX: 0, rightX: canvas.width,
          cropWidthPx: canvas.width, cropHeightPx: canvas.height,
          brickHeight: 32,
          imageData,
        }
        appState = { phase: 'adjusting', crop, brightness: 0, contrast: 0 }
        brightnessSlider.value = '0'
        contrastSlider.value   = '0'
        brightnessValue.textContent = '0'
        contrastValue.textContent   = '0'
        renderPhase(appState)
        renderPreview(imageData, 0, 0)
        resolve()
      }
      img.onerror = () => resolve() // fallback: stay in preparing
      img.src = image.objectUrl
    })
  }

  // ─── Camera availability detection ───────────────────────────────────────────

  async function detectCameraSupport() {
    if (!navigator.mediaDevices?.enumerateDevices) return
    try {
      const devices = await navigator.mediaDevices.enumerateDevices()
      const videoDevices = devices.filter(d => d.kind === 'videoinput')
      if (videoDevices.length === 0) return
      availableVideoDevices = videoDevices
      show(cameraOption)
      show(uploadDivider)
    } catch {
      // Camera enumeration failed silently — upload-only UI remains
    }
  }

  // ─── Camera flow (US1) ────────────────────────────────────────────────────────

  async function startCamera(deviceId?: string) {
    try {
      if (activeStream) stopStream()
      const constraints: MediaStreamConstraints = {
        video: deviceId
          ? { deviceId: { exact: deviceId } }
          : { facingMode: 'user' },
      }
      activeStream = await navigator.mediaDevices.getUserMedia(constraints)
      cameraVideo.srcObject = activeStream

      const session: CameraSession = {
        stream: activeStream,
        activeDeviceId: deviceId ?? availableVideoDevices[0]?.deviceId ?? '',
        availableDevices: availableVideoDevices,
        permissionState: 'granted',
      }

      appState = onCameraSessionReady(appState, session)
      renderPhase(appState)

      cameraSwitchRow.hidden = availableVideoDevices.length < 2

    } catch (err: unknown) {
      const name = err instanceof DOMException ? err.name : 'UnknownError'
      const msg = name === 'NotAllowedError'
        ? 'Camera access was denied. To enable it, click the camera icon in your browser\'s address bar.'
        : name === 'NotFoundError'
        ? 'No camera was found on this device.'
        : 'Camera could not be started. Please try uploading a file instead.'
      appState = onCameraError(appState, msg)
      renderPhase(appState)
    }
  }

  function stopStream() {
    activeStream?.getTracks().forEach(t => t.stop())
    activeStream = null
  }

  useCameraBtn.addEventListener('click', () => startCamera())

  cancelCameraBtn.addEventListener('click', () => {
    stopStream()
    appState = onReset(appState)
    renderPhase(appState)
  })

  switchCameraBtn.addEventListener('click', async () => {
    currentDeviceIndex = (currentDeviceIndex + 1) % availableVideoDevices.length
    await startCamera(availableVideoDevices[currentDeviceIndex].deviceId)
  })

  captureBtn.addEventListener('click', () => {
    if (appState.phase !== 'camera-viewfinder') return
    const canvas = document.createElement('canvas')
    canvas.width  = cameraVideo.videoWidth
    canvas.height = cameraVideo.videoHeight
    canvas.getContext('2d')!.drawImage(cameraVideo, 0, 0)
    canvas.toBlob(blob => {
      if (!blob) return
      const photo: CapturedPhoto = {
        blob,
        widthPx: canvas.width,
        heightPx: canvas.height,
        capturedAt: Date.now(),
      }
      appState = onPhotoCaptured(appState as { phase: 'camera-viewfinder'; session: CameraSession }, photo)
      previewImg.src = URL.createObjectURL(blob)
      renderPhase(appState)
    }, 'image/jpeg', 0.92)
  })

  retakeBtn.addEventListener('click', () => {
    if (appState.phase !== 'camera-preview') return
    appState = onPhotoRetaken(appState as { phase: 'camera-preview'; session: CameraSession })
    renderPhase(appState)
  })

  confirmPhotoBtn.addEventListener('click', async () => {
    if (appState.phase !== 'camera-preview') return
    const { photo, session } = appState as { phase: 'camera-preview'; photo: CapturedPhoto; session: CameraSession }

    stopStream()

    const file = new File([photo.blob], 'capture.jpg', { type: 'image/jpeg' })
    try {
      const image: FaceImage = await validateFile(file)
      appState = onPhotoConfirmed(
        { phase: 'camera-preview', photo, session },
        image,
      )
      renderPhase(appState)
      await prepareFullImageCrop(image) // temporary bypass — replaced by US2
    } catch (err: unknown) {
      const msg = err instanceof Error ? err.message : 'Failed to process photo'
      appState = onCameraError(appState, msg)
      renderPhase(appState)
    }
  })

  // ─── File upload flow ─────────────────────────────────────────────────────────

  uploadInput.addEventListener('change', async () => {
    const file = uploadInput.files?.[0]
    if (!file) return

    appState = onFileSelected({ phase: 'idle' })
    renderPhase(appState)

    try {
      const image: FaceImage = await validateFile(file)
      appState = onFileValidated({ phase: 'uploading' }, image)
      renderPhase(appState)
      await prepareFullImageCrop(image) // temporary bypass — replaced by US2
    } catch (err: unknown) {
      const msg = err instanceof Error ? err.message : 'Failed to load image'
      appState = onFileValidationError({ phase: 'uploading' }, msg)
      renderPhase(appState)
      uploadInput.value = ''
    }
  })

  // ─── Adjustment sliders ────────────────────────────────────────────────────────

  function renderPreview(imageData: ImageData, brightness: number, contrast: number) {
    const adjusted = applyAdjustments(imageData, brightness, contrast)
    const ctx = previewCanvas.getContext('2d')!
    previewCanvas.width  = adjusted.width
    previewCanvas.height = adjusted.height
    ctx.putImageData(adjusted, 0, 0)
  }

  brightnessSlider.addEventListener('input', () => {
    if (appState.phase !== 'adjusting') return
    const val = Number(brightnessSlider.value)
    brightnessValue.textContent = String(val)
    appState = onAdjustmentChanged(appState, 'brightness', val)
    renderPreview(appState.crop.imageData, val, appState.contrast)
  })

  contrastSlider.addEventListener('input', () => {
    if (appState.phase !== 'adjusting') return
    const val = Number(contrastSlider.value)
    contrastValue.textContent = String(val)
    appState = onAdjustmentChanged(appState, 'contrast', val)
    renderPreview(appState.crop.imageData, appState.brightness, val)
  })

  recropBtn.addEventListener('click', () => {
    clearResult()
    stopStream()
    appState = { phase: 'idle' }
    uploadInput.value = ''
    renderPhase(appState)
  })

  // ─── Mosaic generation ────────────────────────────────────────────────────────

  generateBtn.addEventListener('click', () => {
    if (appState.phase !== 'adjusting' && appState.phase !== 'result') return

    const brightness = Number(brightnessSlider.value)
    const contrast   = Number(contrastSlider.value)
    const cropData   = appState.crop as HeadCropSelection
    const adjusted   = applyAdjustments(cropData.imageData, brightness, contrast)

    const adjustedImage: AdjustedImage = {
      source: cropData,
      brightnessOffset: brightness,
      contrastOffset: contrast,
      imageData: adjusted,
    }

    appState = onGenerateClicked(
      { phase: 'adjusting', crop: cropData, brightness, contrast },
      adjustedImage,
    )
    renderPhase(appState)

    requestAnimationFrame(() => {
      setTimeout(() => {
        try {
          const brickHeight = cropData.brickHeight ?? 32
          const mosaic = generateMosaic(adjusted, palette, { height: brickHeight })
          appState = onGenerateSuccess({ phase: 'generating', adjusted: adjustedImage }, mosaic)
          renderPhase(appState)
          renderResult(mosaic, cropData.imageData)
        } catch (err: unknown) {
          console.error('Mosaic generation failed:', err)
          appState = { phase: 'adjusting', crop: cropData, brightness, contrast }
          renderPhase(appState)
        }
      }, 0)
    })
  })

  // ─── Result display ───────────────────────────────────────────────────────────

  function renderResult(mosaic: Mosaic, originalImageData: ImageData) {
    renderOriginal(originalImageData)
    renderMosaicGrid(mosaic)
    renderColorMatrix(mosaic)
    renderPartsList(mosaic)
  }

  function renderOriginal(imageData: ImageData) {
    originalCanvas.width  = imageData.width
    originalCanvas.height = imageData.height
    originalCanvas.getContext('2d')!.putImageData(imageData, 0, 0)
  }

  function renderMosaicGrid(mosaic: Mosaic) {
    mosaicGrid.innerHTML = ''
    const paletteMap = new Map(palette.map(c => [c.id, c]))
    for (const row of mosaic.grid) {
      for (const colorId of row) {
        const color = paletteMap.get(colorId)
        const cell = document.createElement('div')
        cell.className = 'mosaic-cell'
        if (color) {
          const [r, g, b] = color.rgb
          cell.style.background = `rgb(${r},${g},${b})`
          cell.title = color.name
        }
        mosaicGrid.appendChild(cell)
      }
    }
    // Update grid columns for variable width
    const cols = mosaic.width
    mosaicGrid.style.gridTemplateColumns = `repeat(${cols}, 10px)`
  }

  function renderColorMatrix(mosaic: Mosaic) {
    colorMatrixEl.innerHTML = ''
    const paletteMap = new Map(palette.map(c => [c.id, c]))
    for (const row of mosaic.grid) {
      for (const colorId of row) {
        const color = paletteMap.get(colorId)
        const cell = document.createElement('div')
        cell.className = 'matrix-cell'
        if (color) {
          const [r, g, b] = color.rgb
          cell.style.background = `rgb(${r},${g},${b})`
          cell.textContent = color.name.slice(0, 2)
          cell.title = `${color.name} (id: ${color.id})`
        }
        colorMatrixEl.appendChild(cell)
      }
    }
  }

  function renderPartsList(mosaic: Mosaic) {
    const parts = derivePartsList(mosaic, palette)
    totalPiecesEl.textContent = String(parts.totalPieces)
    partsListEl.innerHTML = ''
    for (const entry of parts.entries) {
      const li = document.createElement('li')
      li.innerHTML = `
        <span class="color-swatch" style="background:${entry.rgbHex}" title="${entry.colorName}"></span>
        <span class="color-name">${entry.colorName}</span>
        <span class="color-count">${entry.count}</span>
      `
      partsListEl.appendChild(li)
    }
  }

  function clearResult() {
    mosaicGrid.innerHTML = ''
    colorMatrixEl.innerHTML = ''
    partsListEl.innerHTML = ''
    totalPiecesEl.textContent = '0'
  }

  // ─── Page unload: stop camera stream ─────────────────────────────────────────
  window.addEventListener('beforeunload', () => stopStream())

  // ─── Init ─────────────────────────────────────────────────────────────────────
  detectCameraSupport()
  renderPhase(appState)
</script>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; }

  body {
    font-family: system-ui, -apple-system, sans-serif;
    background: #f8f8f8;
    color: #222;
    margin: 0;
    min-height: 100vh;
  }

  header {
    background: #1a1a2e;
    color: white;
    padding: 1.25rem 2rem;
  }

  .header-inner { max-width: 900px; margin: 0 auto; }

  header h1 { margin: 0; font-size: 1.6rem; letter-spacing: -0.02em; }
  .tagline { margin: 0.2rem 0 0; font-size: 0.9rem; color: #aaa; }
  .more-info { display: inline-block; margin-top: 0.5rem; font-size: 0.8rem; color: #e87722; text-decoration: none; }
  .more-info:hover { text-decoration: underline; }

  main {
    max-width: 900px;
    margin: 2rem auto;
    padding: 0 1rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  #preparing-indicator {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 2rem;
    font-size: 1rem;
    color: #555;
  }

  #preparing-indicator .spinner {
    width: 20px;
    height: 20px;
    border: 3px solid #ddd;
    border-top-color: #e87722;
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
  }

  @keyframes spin { to { transform: rotate(360deg); } }
</style>
