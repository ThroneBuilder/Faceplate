---
import { getGalleries } from '../lib/gallery/config.js'
import { CUBBY_SLOTS, HALL_W, HALL_H, HALL_MOSAIC_SCALE } from '../lib/gallery/cubby-slots.js'
import GalleryNav from '../components/GalleryNav.astro'

interface SubmissionRecord {
  uuid: string
  name: string | null
}

const manifestModules = import.meta.glob<SubmissionRecord[]>('../data/gallery/*.json', {
  eager: true,
  import: 'default',
})

function manifestForSlug(slug: string): SubmissionRecord[] {
  for (const [path, data] of Object.entries(manifestModules)) {
    if (path.endsWith(`/${slug}.json`)) return data
  }
  return []
}

export async function getStaticPaths() {
  return getGalleries().map(g => ({ params: { gallery: g.slug } }))
}

const slug = Astro.params.gallery as string
const gallery = getGalleries().find(g => g.slug === slug)!
const submissions = manifestForSlug(slug)
const BATCH_SIZE = 6

// Build batches of 6; always at least one batch (for empty gallery)
const batches: (string | null)[][] = []
const batchUuids: (string | null)[][] = []
const batchNames: (string | null)[][] = []
const count = Math.max(submissions.length, 1)
for (let i = 0; i < count; i += BATCH_SIZE) {
  const batch: (string | null)[] = []
  const uuids: (string | null)[] = []
  const names: (string | null)[] = []
  for (let j = 0; j < BATCH_SIZE; j++) {
    const sub = submissions[i + j]
    batch.push(sub ? `/gallery/${slug}/${sub.uuid}.png` : null)
    uuids.push(sub ? sub.uuid : null)
    names.push(sub ? (sub.name || null) : null)
  }
  batches.push(batch)
  batchUuids.push(uuids)
  batchNames.push(names)
}

// Name-tooltip positions for each of the 6 mosaic alcoves (canvas-space → %)
const brickPx = Math.round(HALL_H * HALL_MOSAIC_SCALE / 32)
const halfMosPx = 16 * brickPx
const slotTooltipPos = CUBBY_SLOTS.map(s => ({
  left:   ((s.alcoveCx - halfMosPx) / HALL_W * 100).toFixed(2),
  top:    ((s.alcoveCy - halfMosPx) / HALL_H * 100).toFixed(2),
  width:  (halfMosPx * 2 / HALL_W * 100).toFixed(2),
  height: (halfMosPx * 2 / HALL_H * 100).toFixed(2),
}))

const compositeConstants = JSON.stringify({ CUBBY_SLOTS, HALL_W, HALL_H, HALL_MOSAIC_SCALE })
const batchesJson = JSON.stringify(batches)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{gallery.displayName} — Faceplate</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
      *, *::before, *::after { box-sizing: border-box; }
      body { font-family: system-ui, -apple-system, sans-serif; background: #f8f8f8; color: #222; margin: 0; }
      header { background: #1a1a2e; color: white; padding: 1.25rem 2rem; }
      .header-inner { max-width: 960px; margin: 0 auto; display: flex; justify-content: space-between; align-items: flex-start; gap: 2rem; }
      .header-left { flex: 1; min-width: 0; }
      header h1 { margin: 0; font-size: 1.6rem; letter-spacing: -0.02em; }
      .tagline { margin: 0.2rem 0 0; font-size: 0.9rem; color: #aaa; }

      main { max-width: 960px; margin: 2rem auto; padding: 0 1rem; display: flex; flex-direction: column; gap: 2rem; }
      .hall-composite { width: 100%; position: relative; }
      .hall-canvas { width: 100%; height: auto; display: block; border-radius: 8px; border: 1px solid #ddd; }

      /* ── Name tooltips ── */
      .name-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; }
      .name-slot { position: absolute; pointer-events: all; cursor: default; }
      .name-tooltip {
        display: none;
        position: absolute;
        bottom: 100%;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(0,0,0,0.75);
        color: #fff;
        font-size: 0.78rem;
        padding: 0.25rem 0.55rem;
        border-radius: 4px;
        white-space: nowrap;
        pointer-events: none;
        margin-bottom: 4px;
        opacity: 0;
        transition: opacity 0.2s;
      }
      .name-slot:hover .name-tooltip { display: block; opacity: 1; }
    </style>
  </head>
  <body>
    <header>
      <div class="header-inner">
        <div class="header-left">
          <h1>{gallery.displayName}</h1>
          <p class="tagline">{gallery.description}</p>
        </div>
        <GalleryNav currentSlug={slug} />
      </div>
    </header>

    <main>
      {batches.map((_, bi) => (
        <div class="hall-composite">
          <canvas class="hall-canvas" data-batch-index={bi} width={HALL_W} height={HALL_H}></canvas>

          {/* Name tooltips — one per occupied slot with a name */}
          <div class="name-overlay">
            {batchUuids[bi].map((uuid, si) => uuid && batchNames[bi][si] && (
              <div
                class="name-slot"
                style={`left:${slotTooltipPos[si].left}%;top:${slotTooltipPos[si].top}%;width:${slotTooltipPos[si].width}%;height:${slotTooltipPos[si].height}%`}
              >
                <span class="name-tooltip">{batchNames[bi][si]}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </main>

    <script is:inline set:html={`
      window.GALLERY_BATCHES = ${batchesJson};
      window.HALL_COMPOSITING_CONSTANTS = ${compositeConstants};
    `}></script>
    <script src="/scripts/gallery-composite.js" defer></script>
  </body>
</html>
