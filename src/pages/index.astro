    gap: 2rem;
  }

  /* ── Acquisition panel ── */
  #acquisition { display: flex; flex-direction: column; gap: 0.75rem; }

  /* ensure hidden attribute always wins even when element has display: block */
  [hidden] { display: none !important; }

  .acq-layout {
