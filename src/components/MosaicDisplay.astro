---
---
<div id="mosaic-display" hidden>
  <div class="comparison-layout">
    <div class="comparison-item">
      <h3>Original</h3>
      <canvas id="original-canvas" class="comparison-canvas"></canvas>
    </div>
    <div class="comparison-item">
      <h3>LEGO Mosaic</h3>
      <div id="mosaic-grid" class="mosaic-grid" role="img" aria-label="Generated LEGO mosaic"></div>
    </div>
    <!-- color-matrix element retained in DOM for legacy result path; hidden via parent -->
    <div id="color-matrix" hidden></div>
  </div>
</div>

<style>
  #mosaic-display {
    padding: 1rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  .comparison-layout {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
  }

  .comparison-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .comparison-item h3 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #888;
    margin: 0;
  }

  /* Original canvas: height set via JS to match mosaic height; width auto */
  .comparison-canvas {
    border: 1px solid #ddd;
    border-radius: 6px;
    display: block;
    height: auto;  /* overridden by JS */
    width: auto;
  }

  .mosaic-grid {
    display: grid;
    /* columns, rows, and cell size set dynamically in JS */
    gap: 0;
    border: 1px solid #ddd;
    border-radius: 6px;
    overflow: hidden;
  }

  .mosaic-cell {
    width: var(--cell, 10px);
    height: var(--cell, 10px);
  }

  .matrix-cell {
    width: var(--cell, 10px);
    height: var(--cell, 10px);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 5px;
    font-weight: 700;
    line-height: 1;
    color: rgba(0,0,0,0.55);
    overflow: hidden;
  }
</style>
