---
import CandidateGrid from './CandidateGrid.astro'
import HistoryStrip from './HistoryStrip.astro'
---
<section id="candidate-section" hidden aria-label="Mosaic candidate selection">

  <div id="candidate-instruction" class="candidate-instruction">
    <span>Click a candidate to regenerate this far away:</span>
    <select id="candidate-distance" aria-label="Navigation distance">
      <option value="2">2</option>
      <option value="4">4</option>
      <option value="6">6</option>
      <option value="8">8</option>
      <option value="10">10</option>
      <option value="12">12</option>
      <option value="14">14</option>
      <option value="16" selected>16</option>
      <option value="18">18</option>
      <option value="20">20</option>
      <option value="22">22</option>
      <option value="24">24</option>
      <option value="26">26</option>
      <option value="28">28</option>
      <option value="30">30</option>
      <option value="32">32</option>
    </select>
  </div>

  <CandidateGrid />

  <div class="history-area">
    <p class="history-label">Selection history</p>
    <HistoryStrip />
  </div>

  <div class="candidate-actions">
    <button id="confirm-mosaic-btn" class="confirm-mosaic-btn" type="button" disabled>
      Confirm Mosaic
    </button>
  </div>

</section>

<style>
  #candidate-section {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .candidate-instruction {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    justify-content: center;
    margin: 0;
    font-size: 0.88rem;
    color: #555;
  }

  #candidate-distance {
    padding: 0.25rem 0.4rem;
    border: 1px solid #ccc;
    border-radius: 6px;
    font-size: 0.88rem;
    cursor: pointer;
  }

  .history-area {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .history-label {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #888;
  }

  .candidate-actions {
    display: flex;
    justify-content: flex-start;
  }

  .confirm-mosaic-btn {
    padding: 0.7rem 1rem;
    border: none;
    border-radius: 8px;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: not-allowed;
    text-align: center;
    background: #2563eb;
    color: white;
    opacity: 0.4;
    min-width: 180px;
    transition: background 0.15s, opacity 0.15s;
  }

  .confirm-mosaic-btn:not(:disabled) {
    opacity: 1;
    cursor: pointer;
  }

  .confirm-mosaic-btn:not(:disabled):hover {
    background: #1d4ed8;
  }
</style>
