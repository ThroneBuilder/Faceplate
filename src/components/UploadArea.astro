---
---
<div id="upload-area">
  <div class="privacy-notice">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
      <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
    </svg>
    Your image never leaves your device. All processing occurs in your browser.
  </div>

  <label class="upload-label" for="upload-input">
    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <polyline points="16 16 12 12 8 16"></polyline>
      <line x1="12" y1="12" x2="12" y2="21"></line>
      <path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3"></path>
    </svg>
    <span>Choose a photo</span>
    <span class="upload-hint">JPEG or PNG · max 10 MB</span>
    <input
      type="file"
      id="upload-input"
      accept="image/jpeg,image/jpg,image/png"
      aria-label="Upload a face photo"
    />
  </label>

  <p id="upload-error" class="error-message" role="alert" hidden></p>
</div>

<style>
  #upload-area {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 2rem;
  }

  .privacy-notice {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: #4a7c59;
    background: #edf7f0;
    border: 1px solid #c3e6cb;
    border-radius: 6px;
    padding: 0.5rem 0.75rem;
  }

  .upload-label {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 2.5rem 3rem;
    border: 2px dashed #ccc;
    border-radius: 12px;
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
    color: #555;
  }

  .upload-label:hover {
    border-color: #e87722;
    background: #fff8f5;
    color: #e87722;
  }

  .upload-label span { font-weight: 600; font-size: 1.1rem; }
  .upload-hint { font-size: 0.8rem; color: #888; font-weight: 400; }

  .upload-label input[type="file"] {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .error-message {
    color: #c0392b;
    background: #fdf0ee;
    border: 1px solid #f5c6c0;
    border-radius: 6px;
    padding: 0.5rem 0.75rem;
    font-size: 0.9rem;
  }
</style>
