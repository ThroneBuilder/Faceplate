---
import AdjustmentPanel from '../components/AdjustmentPanel.astro'
import MosaicDisplay from '../components/MosaicDisplay.astro'
import PartsList from '../components/PartsList.astro'
import CandidateSection from '../components/CandidateSection.astro'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Faceplate — LEGO Mosaic Generator</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header>
      <div class="header-inner">
        <h1>Faceplate</h1>
        <p class="tagline">Turn any face into a LEGO mosaic</p>
        <a class="more-info" href="https://thronebuilder.com/blog/faceplate/" target="_blank" rel="noopener noreferrer">Learn more about this project ↗</a>
      </div>
    </header>

    <main>
      <!-- Acquisition + crop panel -->
      <section id="acquisition" aria-label="Choose and crop a photo">
        <div class="acq-layout">

          <!-- Left: choose + crop controls -->
          <div class="acq-buttons">
            <p class="acq-section-label">Choose Image</p>

            <button id="camera-btn" type="button">Use Camera</button>
            <label id="upload-label" class="upload-btn">
              <span id="upload-btn-text">Upload Photo</span>
              <input type="file" id="upload-input" accept="image/jpeg,image/jpg,image/png" aria-label="Upload a photo" />
            </label>

            <div class="acq-section-gap"></div>

            <p class="acq-section-label">Crop Image</p>

            <div class="crop-height-row">
              <label for="hct-brick-height">Height</label>
              <select id="hct-brick-height">
                <option value="26">26 bricks</option>
                <option value="28">28 bricks</option>
                <option value="30">30 bricks</option>
                <option value="32" selected>32 bricks</option>
                <option value="34">34 bricks</option>
                <option value="36">36 bricks</option>
              </select>
            </div>

            <button id="use-photo-btn" type="button" disabled>Confirm Crop</button>
            <p id="hct-notice" class="hct-notice" hidden></p>
          </div>

          <!-- Right: image/video box with integrated crop overlay -->
          <div class="acq-box" id="acq-box">
            <p id="acq-placeholder" class="acq-placeholder">Select<br><strong>Use Camera</strong> or <strong>Upload Photo</strong><br>on the left</p>
            <video id="acq-video" autoplay playsinline muted aria-label="Camera viewfinder"></video>
            <img id="acq-image" src="data:," alt="" />
            <!-- Crop overlay (shown when image is ready for cropping) -->
            <div id="hct-dim-top"    class="hct-dim"></div>
            <div id="hct-dim-bottom" class="hct-dim"></div>
            <div id="hct-dim-left"   class="hct-dim"></div>
            <div id="hct-dim-right"  class="hct-dim"></div>
            <div id="hct-frame"></div>
            <div id="hct-handle-top"    class="hct-handle hct-handle-h" role="slider" aria-label="Top crop boundary"    tabindex="0"></div>
            <div id="hct-handle-bottom" class="hct-handle hct-handle-h" role="slider" aria-label="Bottom crop boundary" tabindex="0"></div>
            <div id="hct-handle-left"   class="hct-handle hct-handle-v" role="slider" aria-label="Left crop boundary"   tabindex="0"></div>
            <div id="hct-handle-right"  class="hct-handle hct-handle-v" role="slider" aria-label="Right crop boundary"  tabindex="0"></div>
          </div>

        </div>

        <p class="privacy-notice">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          Your image never leaves your device. All processing occurs in your browser.
        </p>
        <p id="acq-error" class="error-msg" role="alert" hidden></p>
      </section>

      <div id="preparing-indicator" hidden>
        <div class="spinner" aria-hidden="true"></div>
        <span>Preparing image…</span>
      </div>

      <CandidateSection />

      <!-- Result row: appears below candidate section after Confirm Mosaic -->
      <div id="result-row" hidden class="result-row">
        <MosaicDisplay />
      </div>

      <!-- Legacy adjustment flow (deprecated happy-path) -->
      <AdjustmentPanel />
      <!-- PartsList kept in DOM so partsListSection reference resolves; not shown in new flow -->
      <PartsList />
    </main>
  </body>
</html>

<script>
  import type { AppState, FaceImage, HeadCropSelection, HeadBounds, AdjustedImage, Mosaic, BrickHeight } from '../types/index.js'
  import type { LegoColor } from '../types/index.js'
  import { applyAdjustments } from '../lib/image/adjust.js'
  import { validateFile } from '../lib/image/validate.js'
  import { getOrientedImageData } from '../lib/image/exif.js'
  import { initHeadDetector, detectHeadBounds } from '../lib/image/head-detection.js'
  import { computeCropGeometry, clampHandles, scaleToBrickHeight } from '../lib/crop/head-crop.js'
  import { generateMosaic } from '../lib/mosaic/pipeline.js'
  import { derivePartsList } from '../lib/mosaic/parts-list.js'
  import {
    onFileValidated, onFileValidationError,
    onImagePrepared, onBrickHeightChanged, onHeadCropConfirmed, onResetToFullImage,
    onAdjustmentChanged, onGenerateClicked, onGenerateSuccess, onReset,
    onCropConfirmed, onWorkerCellReady, onWorkerCellError,
    onCandidateCellSelected, onHistoryEntryClicked, onConfirmMosaic,
  } from '../lib/app-state.js'
  import { spawnCandidateBatch } from '../lib/candidates/worker-pool.js'
  import { hydrateGridFromCache } from '../lib/candidates/cache.js'
  import PALETTE_RAW from '../data/lego-palette.json'

  const palette: LegoColor[] = PALETTE_RAW as LegoColor[]

  // ─── Unique 2-letter color abbreviations ──────────────────────────────────────

  function buildColorAbbreviations(colors: LegoColor[]): Map<number, string> {
    const used = new Set<string>()
    const result = new Map<number, string>()
    for (const color of colors) {
      const words = color.name.trim().split(/\s+/)
      const candidates: string[] = [
        words.length >= 2 ? (words[0][0] + words[1][0]).toUpperCase() : color.name.slice(0, 2).toUpperCase(),
        color.name.replace(/\s/g, '').slice(0, 2).toUpperCase(),
        (color.name[0] + (color.name.replace(/\s/g, '')[2] ?? color.name[1])).toUpperCase(),
        (color.name[0] + color.name[color.name.length - 1]).toUpperCase(),
        words[words.length - 1].slice(0, 2).toUpperCase(),
      ]
      let abbr = candidates.find(c => c.length === 2 && !used.has(c)) ?? ''
      if (!abbr) {
        const az = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'
        outer: for (const a of az) for (const b of az) { if (!used.has(a+b)) { abbr = a+b; break outer } }
      }
      used.add(abbr)
      result.set(color.id, abbr)
    }
    return result
  }

  const colorAbbr = buildColorAbbreviations(palette)

  // ─── App state ────────────────────────────────────────────────────────────────

  let appState: AppState = { phase: 'idle' }

  // ─── Acquisition state (local to the panel) ───────────────────────────────────

  type AcqMode = 'idle' | 'camera-live' | 'camera-captured' | 'file-ready'
  let acqMode: AcqMode = 'idle'
  let activeStream: MediaStream | null = null
  let availableVideoDevices: MediaDeviceInfo[] = []
  let currentDeviceIndex = 0
  let pendingFile: File | null = null

  // ─── Head crop state ──────────────────────────────────────────────────────────

  let correctedImageData: ImageData | null = null  // EXIF-corrected pixels
  let hctTopPx    = 0    // handle positions in CSS display pixels
  let hctBotPx    = 0
  let hctLeftPx   = 0
  let hctRightPx  = 0
  let hctDragging: 'top' | 'bottom' | 'left' | 'right' | null = null
  let hctDragStartX   = 0
  let hctDragStartY   = 0
  let hctDragStartTop = 0
  let hctDragStartBot = 0
  let hctDragStartLeft  = 0
  let hctDragStartRight = 0

  // ─── DOM — acquisition ────────────────────────────────────────────────────────

  const acquisitionEl   = document.getElementById('acquisition')!
  const cameraBtnEl     = document.getElementById('camera-btn') as HTMLButtonElement
  const uploadLabelEl   = document.getElementById('upload-label')!
  const uploadBtnText   = document.getElementById('upload-btn-text')!
  const uploadInput     = document.getElementById('upload-input') as HTMLInputElement
  const usePhotoBtnEl   = document.getElementById('use-photo-btn') as HTMLButtonElement
  const acqBox          = document.getElementById('acq-box')!
  const acqPlaceholder  = document.getElementById('acq-placeholder')!
  const acqVideo        = document.getElementById('acq-video') as HTMLVideoElement
  const acqImage        = document.getElementById('acq-image') as HTMLImageElement
  const acqError        = document.getElementById('acq-error')!

  // ─── DOM — downstream ─────────────────────────────────────────────────────────

  // ─── DOM — HeadCropTool ───────────────────────────────────────────────────────

  // HeadCropTool is now embedded in acq-box; use acqImage/acqBox directly
  const hctDimTop       = document.getElementById('hct-dim-top')!
  const hctDimBottom    = document.getElementById('hct-dim-bottom')!
  const hctDimLeft      = document.getElementById('hct-dim-left')!
  const hctDimRight     = document.getElementById('hct-dim-right')!
  const hctFrame        = document.getElementById('hct-frame')!
  const hctHandleTop    = document.getElementById('hct-handle-top')!
  const hctHandleBottom = document.getElementById('hct-handle-bottom')!
  const hctHandleLeft   = document.getElementById('hct-handle-left')!
  const hctHandleRight  = document.getElementById('hct-handle-right')!
  const hctBrickHeight  = document.getElementById('hct-brick-height') as HTMLSelectElement
  const hctNotice       = document.getElementById('hct-notice')!

  const candidateSectionEl    = document.getElementById('candidate-section')!
  const candidateInstructionEl = document.getElementById('candidate-instruction')!
  const candidateGridEl       = document.getElementById('candidate-grid')!
  const historyStripEl        = document.getElementById('history-strip')!
  const confirmMosaicBtn      = document.getElementById('confirm-mosaic-btn') as HTMLButtonElement
  const resultRowEl           = document.getElementById('result-row')!

  const adjustmentPanel   = document.getElementById('adjustment-panel')!
  const previewCanvas     = document.getElementById('preview-canvas') as HTMLCanvasElement
  const brightnessSlider  = document.getElementById('brightness-slider') as HTMLInputElement
  const contrastSlider    = document.getElementById('contrast-slider') as HTMLInputElement
  const brightnessValue   = document.getElementById('brightness-value')!
  const contrastValue     = document.getElementById('contrast-value')!
  const generateBtn       = document.getElementById('generate-button') as HTMLButtonElement
  const recropBtn         = document.getElementById('recrop-button') as HTMLButtonElement
  const progressIndicator = document.getElementById('progress-indicator')!

  const mosaicDisplay     = document.getElementById('mosaic-display')!
  const mosaicGrid        = document.getElementById('mosaic-grid')!
  const originalCanvas    = document.getElementById('original-canvas') as HTMLCanvasElement

  const colorMatrixEl     = document.getElementById('color-matrix')!  // now inside #mosaic-display

  const partsListSection  = document.getElementById('parts-list-section')!
  const partsListEl       = document.getElementById('parts-list')!
  const totalPiecesEl     = document.getElementById('total-pieces')!

  // ─── Helpers ──────────────────────────────────────────────────────────────────

  function show(el: HTMLElement) { el.hidden = false }
  function hide(el: HTMLElement) { el.hidden = true }

  function showAcqError(msg: string) { acqError.textContent = msg; acqError.hidden = false }
  function clearAcqError() { acqError.textContent = ''; acqError.hidden = true }

  // ─── Acquisition panel state ──────────────────────────────────────────────────

  function setAcqMode(mode: AcqMode) {
    acqMode = mode
    clearAcqError()

    cameraBtnEl.textContent =
      mode === 'camera-live'     ? 'Take Photo'    :
      mode === 'camera-captured' ? 'Retake Photo'  : 'Use Camera'

    uploadBtnText.textContent =
      mode === 'file-ready' ? 'Reupload Photo' : 'Upload Photo'

    usePhotoBtnEl.disabled = mode !== 'camera-captured' && mode !== 'file-ready'

    // show/hide exactly one child at a time
    acqPlaceholder.hidden = mode !== 'idle'
    acqVideo.hidden       = mode !== 'camera-live'
    acqImage.hidden       = mode === 'idle' || mode === 'camera-live'
  }

  // ─── Camera ───────────────────────────────────────────────────────────────────

  async function startCamera(deviceId?: string) {
    try {
      stopStream()
      const constraints: MediaStreamConstraints = {
        video: deviceId ? { deviceId: { exact: deviceId } } : { facingMode: 'user' },
      }
      activeStream = await navigator.mediaDevices.getUserMedia(constraints)
      acqVideo.srcObject = activeStream
      setAcqMode('camera-live')
    } catch (err: unknown) {
      const name = err instanceof DOMException ? err.name : ''
      const msg = name === 'NotAllowedError'
        ? 'Camera access denied. Click the camera icon in your browser\'s address bar to re-enable.'
        : name === 'NotFoundError'
        ? 'No camera found on this device.'
        : 'Could not start camera. Try uploading a file instead.'
      showAcqError(msg)
    }
  }

  function capturePhoto() {
    const canvas = document.createElement('canvas')
    canvas.width  = acqVideo.videoWidth
    canvas.height = acqVideo.videoHeight
    canvas.getContext('2d')!.drawImage(acqVideo, 0, 0)
    canvas.toBlob(blob => {
      if (!blob) return
      stopStream()
      resetDownstream()
      pendingFile = new File([blob], 'capture.jpg', { type: 'image/jpeg' })
      acqImage.src = URL.createObjectURL(blob)
      setAcqMode('camera-captured')
      autoPrepareCrop()
    }, 'image/jpeg', 0.92)
  }

  function stopStream() {
    activeStream?.getTracks().forEach(t => t.stop())
    activeStream = null
  }

  // Check if camera is available and update button visibility
  async function detectCameraSupport() {
    if (!navigator.mediaDevices?.enumerateDevices) return
    try {
      const devices = await navigator.mediaDevices.enumerateDevices()
      availableVideoDevices = devices.filter(d => d.kind === 'videoinput')
    } catch { /* camera unavailable — button still visible but will show error */ }
  }

  // ─── Button events ────────────────────────────────────────────────────────────

  cameraBtnEl.addEventListener('click', async () => {
    if (acqMode === 'idle' || acqMode === 'file-ready') {
      await startCamera(availableVideoDevices[currentDeviceIndex]?.deviceId)
    } else if (acqMode === 'camera-live') {
      capturePhoto()
    } else if (acqMode === 'camera-captured') {
      await startCamera(availableVideoDevices[currentDeviceIndex]?.deviceId)
    }
  })

  uploadInput.addEventListener('change', () => {
    const file = uploadInput.files?.[0]
    if (!file) return
    stopStream()
    resetDownstream()
    pendingFile = file
    acqImage.src = URL.createObjectURL(file)
    setAcqMode('file-ready')
    autoPrepareCrop()
  })

  // "Confirm Crop" — extract the crop at current handle positions and proceed
  usePhotoBtnEl.addEventListener('click', () => {
    if (!correctedImageData) return
    const iW = correctedImageData.width
    const iH = correctedImageData.height
    const dW = acqImage.offsetWidth
    const dH = acqImage.offsetHeight
    if (!dW || !dH) return

    const topY    = Math.round(hctTopPx  / dH * iH)
    const bottomY = Math.round(hctBotPx  / dH * iH)
    const leftX   = Math.round(hctLeftPx / dW * iW)
    const rightX  = Math.round(hctRightPx/ dW * iW)
    const cropWidthPx  = Math.max(1, rightX  - leftX)
    const cropHeightPx = Math.max(1, bottomY - topY)
    const bh = Math.max(1, Math.round(32 * cropHeightPx / cropWidthPx)) as BrickHeight

    const srcCanvas  = document.createElement('canvas')
    srcCanvas.width  = iW; srcCanvas.height = iH
    srcCanvas.getContext('2d')!.putImageData(correctedImageData, 0, 0)
    const cropCanvas  = document.createElement('canvas')
    cropCanvas.width  = cropWidthPx; cropCanvas.height = cropHeightPx
    cropCanvas.getContext('2d')!.drawImage(srcCanvas, -leftX, -topY)
    const cropImageData = cropCanvas.getContext('2d')!.getImageData(0, 0, cropWidthPx, cropHeightPx)

    const crop: HeadCropSelection = { topY, bottomY, leftX, rightX, cropWidthPx, cropHeightPx, brickHeight: bh, imageData: cropImageData }
    hideCropOverlay()
    appState = onCropConfirmed(appState as { phase: 'head-cropping' }, crop)
    renderPhase(appState)
    startCandidateBatch()
  })

  // ─── Crop overlay (embedded in acq-box) ──────────────────────────────────────

  async function autoPrepareCrop(): Promise<void> {
    if (!pendingFile) return
    usePhotoBtnEl.disabled = true
    clearAcqError()
    hideCropOverlay()
    const preparingEl = document.getElementById('preparing-indicator')!
    show(preparingEl)
    try {
      correctedImageData = await getOrientedImageData(pendingFile)
      // Replace acq-image src with EXIF-corrected version
      const tmpCanvas = document.createElement('canvas')
      tmpCanvas.width  = correctedImageData.width
      tmpCanvas.height = correctedImageData.height
      tmpCanvas.getContext('2d')!.putImageData(correctedImageData, 0, 0)
      tmpCanvas.toBlob(blob => {
        if (!blob) return
        acqImage.src = URL.createObjectURL(blob)
        acqImage.onload = () => {
          // Box: expand to natural image ratio so image fills without letterboxing
          acqBox.classList.add('crop-active')
          acqImage.style.cssText = 'display:block;width:100%;height:auto;'
        }
      })
      await initHeadDetector()
      const headBounds = detectHeadBounds(correctedImageData)
      // Wait one frame for image layout before seeding handles
      await new Promise<void>(r => requestAnimationFrame(() => requestAnimationFrame(() => r())))
      seedHandles(correctedImageData, headBounds)
      usePhotoBtnEl.disabled = false
    } catch (err: unknown) {
      showAcqError(err instanceof Error ? err.message : 'Failed to prepare image')
    } finally {
      hide(preparingEl)
    }
  }

  function seedHandles(imgData: ImageData, headBounds: HeadBounds): void {
    const W = acqImage.offsetWidth
    const H = acqImage.offsetHeight
    const found = headBounds.detectionStatus === 'found'
    hctTopPx   = found ? Math.max(0, Math.round(headBounds.topY    / imgData.height * H)) : 0
    hctBotPx   = found ? Math.min(H, Math.round(headBounds.bottomY / imgData.height * H)) : H
    hctLeftPx  = (found && headBounds.leftX  != null) ? Math.max(0, Math.round(headBounds.leftX  / imgData.width * W)) : 0
    hctRightPx = (found && headBounds.rightX != null) ? Math.min(W, Math.round(headBounds.rightX / imgData.width * W)) : W
    if (headBounds.detectionStatus !== 'found') {
      hctNotice.textContent = headBounds.detectionStatus === 'too-small'
        ? 'Detection too small — handles set to full image.' : 'Head not detected — adjust handles manually.'
      hctNotice.hidden = false
    } else {
      hctNotice.hidden = true
    }
    showCropOverlay()
    updateHctOverlay()
  }

  function showCropOverlay(): void {
    [hctDimTop, hctDimBottom, hctDimLeft, hctDimRight, hctFrame,
     hctHandleTop, hctHandleBottom, hctHandleLeft, hctHandleRight
    ].forEach(el => { el.hidden = false })
  }

  function hideCropOverlay(): void {
    [hctDimTop, hctDimBottom, hctDimLeft, hctDimRight, hctFrame,
     hctHandleTop, hctHandleBottom, hctHandleLeft, hctHandleRight
    ].forEach(el => { el.hidden = true })
    acqBox.classList.remove('crop-active')
    acqImage.style.cssText = ''
  }

  function updateHctOverlay(): void {
    const W   = acqImage.offsetWidth
    const H   = acqImage.offsetHeight
    const lx  = hctLeftPx
    const rx  = hctRightPx
    const cropW = rx - lx
    const cropH = hctBotPx - hctTopPx

    // Dim regions
    hctDimTop.style.cssText    = `left:0;top:0;width:100%;height:${hctTopPx}px`
    hctDimBottom.style.cssText = `left:0;top:${hctBotPx}px;width:100%;height:${H - hctBotPx}px`
    hctDimLeft.style.cssText   = `left:0;top:${hctTopPx}px;width:${lx}px;height:${cropH}px`
    hctDimRight.style.cssText  = `left:${rx}px;top:${hctTopPx}px;width:${W - rx}px;height:${cropH}px`

    // Crop frame border
    hctFrame.style.cssText = `left:${lx}px;top:${hctTopPx}px;width:${cropW}px;height:${cropH}px`

    // Horizontal handles (top/bottom crop lines)
    hctHandleTop.style.cssText    = `left:0;right:0;top:${hctTopPx - 12}px;height:24px`
    hctHandleBottom.style.cssText = `left:0;right:0;top:${hctBotPx - 12}px;height:24px`

    // Vertical handles (left/right crop lines), spanning the crop height
    hctHandleLeft.style.cssText  = `left:${lx - 12}px;top:${hctTopPx}px;width:24px;height:${cropH}px`
    hctHandleRight.style.cssText = `left:${rx - 12}px;top:${hctTopPx}px;width:24px;height:${cropH}px`
  }

  // Drag interaction
  hctHandleTop.addEventListener('pointerdown', e => {
    hctDragging = 'top'; hctDragStartY = e.clientY; hctDragStartTop = hctTopPx
    hctHandleTop.setPointerCapture(e.pointerId)
  })
  hctHandleBottom.addEventListener('pointerdown', e => {
    hctDragging = 'bottom'; hctDragStartY = e.clientY; hctDragStartBot = hctBotPx
    hctHandleBottom.setPointerCapture(e.pointerId)
  })
  hctHandleLeft.addEventListener('pointerdown', e => {
    hctDragging = 'left'; hctDragStartX = e.clientX; hctDragStartLeft = hctLeftPx
    hctHandleLeft.setPointerCapture(e.pointerId)
  })
  hctHandleRight.addEventListener('pointerdown', e => {
    hctDragging = 'right'; hctDragStartX = e.clientX; hctDragStartRight = hctRightPx
    hctHandleRight.setPointerCapture(e.pointerId)
  })

  acqBox.addEventListener('pointermove', e => {
    if (!hctDragging) return
    const W   = acqImage.offsetWidth
    const H   = acqImage.offsetHeight
    const MIN = 100

    if (hctDragging === 'top') {
      hctTopPx = Math.max(0, Math.min(hctDragStartTop + (e.clientY - hctDragStartY), hctBotPx - MIN))
    } else if (hctDragging === 'bottom') {
      hctBotPx = Math.max(hctTopPx + MIN, Math.min(hctDragStartBot + (e.clientY - hctDragStartY), H))
    } else if (hctDragging === 'left') {
      hctLeftPx = Math.max(0, Math.min(hctDragStartLeft + (e.clientX - hctDragStartX), hctRightPx - MIN))
    } else if (hctDragging === 'right') {
      hctRightPx = Math.max(hctLeftPx + MIN, Math.min(hctDragStartRight + (e.clientX - hctDragStartX), W))
    }
    updateHctOverlay()
  })

  acqBox.addEventListener('pointerup',     () => { hctDragging = null })
  acqBox.addEventListener('pointercancel', () => { hctDragging = null })

  // Brick height change — only updates mosaic output height, not the crop handles
  hctBrickHeight.addEventListener('change', () => {
    if (appState.phase !== 'head-cropping') return
    const bh = Number(hctBrickHeight.value) as BrickHeight
    appState = onBrickHeightChanged(
      appState as { phase: 'head-cropping'; image: FaceImage; headBounds: HeadBounds; brickHeight: BrickHeight },
      bh,
    )
  })

  // (Confirm crop is handled by usePhotoBtnEl above)

  // ─── App phase rendering ──────────────────────────────────────────────────────

  // Abort in-progress generation and hide all downstream sections.
  // Called when the user selects a new photo or camera capture.
  function resetDownstream() {
    candidateAbortController?.abort()
    candidateAbortController = null
    appState = { phase: 'idle' }
    hide(candidateSectionEl)
    hide(resultRowEl)
    hide(mosaicDisplay)
    hide(partsListSection)
    hide(adjustmentPanel)
  }

  function renderPhase(state: AppState) {
    // acquisitionEl is ALWAYS visible — never hidden here.
    // Only downstream sections are toggled.
    hide(adjustmentPanel)
    hide(mosaicDisplay); hide(partsListSection)
    hide(candidateSectionEl); hide(resultRowEl)

    switch (state.phase) {
      case 'idle':
      case 'uploading':
      case 'upload-error':
      case 'camera-viewfinder':
      case 'camera-preview':
      case 'camera-error':
      case 'preparing':
      case 'head-cropping':
      case 'head-crop-error':
        break  // acquisition section already visible

      case 'candidate-grid':
        show(candidateSectionEl)
        renderCandidateGrid(state.grid, state.history, state.cache)
        break

      case 'mosaic-confirmed':
        show(candidateSectionEl)
        confirmMosaicBtn.disabled = true
        show(resultRowEl)
        show(mosaicDisplay)
        renderResult(state.mosaic, state.crop.imageData, 5)
        break

      case 'adjusting':
      case 'generating':
        show(adjustmentPanel)
        generateBtn.disabled  = state.phase === 'generating'
        progressIndicator.hidden = state.phase !== 'generating'
        break

      case 'result':
        show(adjustmentPanel)
        show(mosaicDisplay)
        show(partsListSection)
        generateBtn.disabled  = false
        progressIndicator.hidden = true
        break
    }
  }

  // ─── Adjustment sliders ───────────────────────────────────────────────────────

  function renderPreview(imageData: ImageData, brightness: number, contrast: number) {
    const adjusted = applyAdjustments(imageData, brightness, contrast)
    const ctx = previewCanvas.getContext('2d')!
    previewCanvas.width  = adjusted.width
    previewCanvas.height = adjusted.height
    ctx.putImageData(adjusted, 0, 0)
  }

  brightnessSlider.addEventListener('input', () => {
    if (appState.phase !== 'adjusting') return
    const val = Number(brightnessSlider.value)
    brightnessValue.textContent = String(val)
    appState = onAdjustmentChanged(appState, 'brightness', val)
    renderPreview(appState.crop.imageData, val, appState.contrast)
  })

  contrastSlider.addEventListener('input', () => {
    if (appState.phase !== 'adjusting') return
    const val = Number(contrastSlider.value)
    contrastValue.textContent = String(val)
    appState = onAdjustmentChanged(appState, 'contrast', val)
    renderPreview(appState.crop.imageData, appState.brightness, val)
  })

  recropBtn.addEventListener('click', () => {
    stopStream()
    hideCropOverlay()
    clearResult()
    correctedImageData = null
    pendingFile = null
    uploadInput.value = ''
    setAcqMode('idle')
    resetDownstream()
  })

  // ─── Mosaic generation ────────────────────────────────────────────────────────

  generateBtn.addEventListener('click', () => {
    if (appState.phase !== 'adjusting' && appState.phase !== 'result') return

    const brightness = Number(brightnessSlider.value)
    const contrast   = Number(contrastSlider.value)
    const crop       = appState.crop as HeadCropSelection
    const adjusted   = applyAdjustments(crop.imageData, brightness, contrast)

    const adjustedImage: AdjustedImage = {
      source: crop,
      brightnessOffset: brightness,
      contrastOffset: contrast,
      imageData: adjusted,
    }

    appState = onGenerateClicked(
      { phase: 'adjusting', crop, brightness, contrast },
      adjustedImage,
    )
    renderPhase(appState)

    requestAnimationFrame(() => {
      setTimeout(() => {
        try {
          const mosaic = generateMosaic(adjusted, palette, { height: crop.brickHeight ?? 32 })
          appState = onGenerateSuccess({ phase: 'generating', adjusted: adjustedImage }, mosaic)
          renderPhase(appState)
          renderResult(mosaic, crop.imageData)
        } catch (err: unknown) {
          console.error('Mosaic generation failed:', err)
          appState = { phase: 'adjusting', crop, brightness, contrast }
          renderPhase(appState)
        }
      }, 0)
    })
  })

  // ─── Result ───────────────────────────────────────────────────────────────────

  function renderResult(mosaic: Mosaic, originalImageData: ImageData, cellPx = 10) {
    renderMosaicGrid(mosaic, cellPx)
    renderOriginal(originalImageData, mosaic, cellPx)
    renderColorMatrix(mosaic, cellPx)
    renderPartsList(mosaic)
  }

  function renderOriginal(imageData: ImageData, mosaic: Mosaic, cellPx = 10) {
    originalCanvas.width  = imageData.width
    originalCanvas.height = imageData.height
    originalCanvas.getContext('2d')!.putImageData(imageData, 0, 0)
    const displayH = mosaic.height * cellPx
    originalCanvas.style.height = displayH + 'px'
    originalCanvas.style.width  = Math.round(displayH * imageData.width / imageData.height) + 'px'
  }

  function renderMosaicGrid(mosaic: Mosaic, cellPx = 10) {
    mosaicGrid.innerHTML = ''
    mosaicGrid.style.gridTemplateColumns = `repeat(${mosaic.width}, ${cellPx}px)`
    mosaicGrid.style.gridTemplateRows    = `repeat(${mosaic.height}, ${cellPx}px)`
    const paletteMap = new Map(palette.map(c => [c.id, c]))
    for (const row of mosaic.grid) {
      for (const colorId of row) {
        const color = paletteMap.get(colorId)
        const cell  = document.createElement('div')
        cell.className = 'mosaic-cell'
        if (color) {
          const [r, g, b] = color.rgb
          cell.style.background = `rgb(${r},${g},${b})`
          cell.title = color.name
        }
        mosaicGrid.appendChild(cell)
      }
    }
  }

  function renderColorMatrix(mosaic: Mosaic, cellPx = 10) {
    colorMatrixEl.innerHTML = ''
    colorMatrixEl.style.gridTemplateColumns = `repeat(${mosaic.width}, ${cellPx}px)`
    colorMatrixEl.style.gridTemplateRows    = `repeat(${mosaic.height}, ${cellPx}px)`
    const paletteMap = new Map(palette.map(c => [c.id, c]))
    for (const row of mosaic.grid) {
      for (const colorId of row) {
        const color = paletteMap.get(colorId)
        const cell  = document.createElement('div')
        cell.className = 'matrix-cell'
        if (color) {
          const [r, g, b] = color.rgb
          cell.style.background = `rgb(${r},${g},${b})`
          cell.textContent = colorAbbr.get(color.id) ?? color.name.slice(0, 2).toUpperCase()
          cell.title = `${color.name} (id: ${color.id})`
        }
        colorMatrixEl.appendChild(cell)
      }
    }
  }

  function renderPartsList(mosaic: Mosaic) {
    const parts = derivePartsList(mosaic, palette)
    totalPiecesEl.textContent = String(parts.totalPieces)
    partsListEl.innerHTML = ''
    for (const entry of parts.entries) {
      const li = document.createElement('li')
      li.innerHTML = `
        <span class="color-swatch" style="background:${entry.rgbHex}" title="${entry.colorName}"></span>
        <span class="color-name">${entry.colorName}</span>
        <span class="color-count">${entry.count}</span>
      `
      partsListEl.appendChild(li)
    }
  }

  function clearResult() {
    mosaicGrid.innerHTML = ''
    colorMatrixEl.innerHTML = ''
    partsListEl.innerHTML = ''
    totalPiecesEl.textContent = '0'
  }

  // ─── Candidate grid ───────────────────────────────────────────────────────────

  let candidateAbortController: AbortController | null = null

  function renderCandidateGrid(
    grid: import('../types/index.js').CandidateGrid,
    history: import('../types/index.js').SelectionHistory,
    cache: import('../types/index.js').CandidateCache,
  ) {
    // Instruction text
    candidateInstructionEl.textContent = grid.atMinimumStep
      ? 'Maximum refinement reached — click Confirm Mosaic to continue'
      : 'Click a candidate to refine your selection'

    // Update cells
    for (let i = 0; i < 9; i++) {
      const cell = grid.cells[i]
      const el = document.getElementById(`cell-${i}`)
      if (!el) continue
      el.dataset.status = cell.status
      el.dataset.cellIndex = String(i)

      if (cell.status === 'ready' && cell.mosaic) {
        const canvas = el.querySelector('canvas') as HTMLCanvasElement
        drawMosaicThumbnail(canvas, cell.mosaic)
      }
    }

    // Confirm Mosaic button
    const centerReady = grid.cells[4].status === 'ready'
    confirmMosaicBtn.disabled = !centerReady

    // History strip
    renderHistoryStrip(history, cache)
  }

  function drawMosaicThumbnail(canvas: HTMLCanvasElement, mosaic: import('../types/index.js').Mosaic) {
    const cellSize = canvas.parentElement?.offsetWidth ?? 140
    const brickPx = Math.max(1, Math.floor(cellSize / mosaic.width))
    const totalW = mosaic.width * brickPx
    const totalH = mosaic.height * brickPx
    canvas.width  = totalW
    canvas.height = totalH
    const ctx = canvas.getContext('2d')!
    const paletteMap = new Map(palette.map(c => [c.id, c]))
    for (let r = 0; r < mosaic.height; r++) {
      for (let c = 0; c < mosaic.width; c++) {
        const colorId = mosaic.grid[r][c]
        const color = paletteMap.get(colorId)
        if (color) {
          const [rv, g, b] = color.rgb
          ctx.fillStyle = `rgb(${rv},${g},${b})`
          ctx.fillRect(c * brickPx, r * brickPx, brickPx, brickPx)
        }
      }
    }
  }

  function renderHistoryStrip(
    history: import('../types/index.js').SelectionHistory,
    cache: import('../types/index.js').CandidateCache,
  ) {
    historyStripEl.innerHTML = ''
    history.entries.forEach((entry, idx) => {
      const div = document.createElement('div')
      div.className = 'history-entry'
      if (idx === history.activeIndex) div.classList.add('history-entry--active')
      else if (idx > history.activeIndex) div.classList.add('history-entry--forward')
      div.dataset.historyIndex = String(idx)
      div.setAttribute('role', 'listitem')
      div.setAttribute('aria-label', idx === 0 ? 'Default (no adjustment)' : `B${entry.key.brightnessOffset} C${entry.key.contrastOffset}`)

      const cacheKey = `${entry.key.brightnessOffset}:${entry.key.contrastOffset}`
      const cached = cache.get(cacheKey)
      if (cached) {
        const canvas = document.createElement('canvas')
        div.appendChild(canvas)
        drawMosaicThumbnail(canvas, cached)
      }

      if (idx !== history.activeIndex) {
        div.style.cursor = 'pointer'
        div.addEventListener('click', () => {
          if (appState.phase !== 'candidate-grid') return
          candidateAbortController?.abort()
          candidateAbortController = new AbortController()
          appState = onHistoryEntryClicked(
            appState as Extract<typeof appState, { phase: 'candidate-grid' }>,
            idx,
          )
          renderPhase(appState)
          // Spawn workers for any cells not in cache
          startCandidateBatch()
        })
      }

      historyStripEl.appendChild(div)
    })
    // Scroll to end to show most recent
    historyStripEl.scrollLeft = historyStripEl.scrollWidth
  }

  function startCandidateBatch() {
    if (appState.phase !== 'candidate-grid') return
    const state = appState as Extract<typeof appState, { phase: 'candidate-grid' }>
    const missing = hydrateGridFromCache(state.grid, state.cache)
    if (missing.length === 0) {
      renderCandidateGrid(state.grid, state.history, state.cache)
      return
    }
    const ctrl = new AbortController()
    candidateAbortController = ctrl
    spawnCandidateBatch({
      grid: state.grid,
      missing,
      cropImageData: state.crop.imageData,
      palette,
      cache: state.cache,
      signal: ctrl.signal,
      onCellReady: (index, mosaic, durationMs) => {
        if (appState.phase !== 'candidate-grid') return
        if (ctrl.signal.aborted) return
        state.cache.set(`${state.grid.cells[index].key.brightnessOffset}:${state.grid.cells[index].key.contrastOffset}`, mosaic)
        appState = onWorkerCellReady(
          appState as Extract<typeof appState, { phase: 'candidate-grid' }>,
          index, mosaic, durationMs,
        )
        if (durationMs) console.log(`[candidate] cell ${index} ready in ${durationMs.toFixed(0)}ms`)
        renderCandidateGrid(
          (appState as Extract<typeof appState, { phase: 'candidate-grid' }>).grid,
          (appState as Extract<typeof appState, { phase: 'candidate-grid' }>).history,
          (appState as Extract<typeof appState, { phase: 'candidate-grid' }>).cache,
        )
      },
      onCellError: (index, error) => {
        if (appState.phase !== 'candidate-grid') return
        if (ctrl.signal.aborted) return
        appState = onWorkerCellError(
          appState as Extract<typeof appState, { phase: 'candidate-grid' }>,
          index, error,
        )
        renderCandidateGrid(
          (appState as Extract<typeof appState, { phase: 'candidate-grid' }>).grid,
          (appState as Extract<typeof appState, { phase: 'candidate-grid' }>).history,
          (appState as Extract<typeof appState, { phase: 'candidate-grid' }>).cache,
        )
      },
    })
  }

  // Grid cell clicks (delegated from candidateGridEl)
  candidateGridEl.addEventListener('click', (e) => {
    if (appState.phase !== 'candidate-grid') return
    const cellEl = (e.target as Element).closest('[data-cell-index]') as HTMLElement | null
    if (!cellEl) return
    const idx = Number(cellEl.dataset.cellIndex)
    if (idx === 4) return  // center — no-op
    const state = appState as Extract<typeof appState, { phase: 'candidate-grid' }>
    if (state.grid.cells[idx].status !== 'ready') return

    candidateAbortController?.abort()
    candidateAbortController = new AbortController()
    appState = onCandidateCellSelected(state, idx)
    renderPhase(appState)
    startCandidateBatch()
  })

  // Confirm Mosaic button
  confirmMosaicBtn.addEventListener('click', () => {
    if (appState.phase !== 'candidate-grid') return
    const state = appState as Extract<typeof appState, { phase: 'candidate-grid' }>
    if (state.grid.cells[4].status !== 'ready') return
    candidateAbortController?.abort()
    candidateAbortController = null
    appState = onConfirmMosaic(state)
    renderPhase(appState)
  })

  // ─── Cleanup on unload ────────────────────────────────────────────────────────

  window.addEventListener('beforeunload', () => stopStream())

  // ─── Init ─────────────────────────────────────────────────────────────────────

  detectCameraSupport()
  setAcqMode('idle')
  renderPhase(appState)
</script>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; }

