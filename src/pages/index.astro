  #use-photo-btn          { background: #2c6e49; color: white; }
  #use-photo-btn:hover:not(:disabled) { background: #1f5235; }
  #use-photo-btn:disabled { opacity: 0.4; cursor: not-allowed; }

  /* ── Section labels + spacer ── */
  .acq-section-label {
    font-size: 0.72rem;
