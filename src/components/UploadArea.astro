---
---
<div id="upload-area">
  <!-- Camera option — shown only when getUserMedia is available (set visible by JS) -->
  <div id="camera-option" hidden>
    <button id="use-camera-btn" type="button" class="camera-btn">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
        <circle cx="12" cy="13" r="4"/>
      </svg>
      Use Camera
    </button>
    <p id="camera-hint">Take a photo directly from your device</p>
    <p id="camera-error-msg" class="error-message" role="alert" hidden></p>
  </div>

  <div id="upload-divider" hidden>
    <span>or</span>
  </div>

  <!-- File upload — always visible -->
  <div class="privacy-notice">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
      <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
    </svg>
    Your image never leaves your device. All processing occurs in your browser.
  </div>

  <label class="upload-label" for="upload-input">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <polyline points="16 16 12 12 8 16"></polyline>
      <line x1="12" y1="12" x2="12" y2="21"></line>
      <path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3"></path>
    </svg>
    <span>Choose a file</span>
    <span class="upload-hint">JPEG or PNG · max 10 MB</span>
    <input
      type="file"
      id="upload-input"
      accept="image/jpeg,image/jpg,image/png"
      aria-label="Upload a face photo"
    />
  </label>

  <p id="upload-error" class="error-message" role="alert" hidden></p>
</div>

<style>
  #upload-area {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 2rem;
  }

  #camera-option {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    width: 100%;
    max-width: 340px;
  }

  .camera-btn {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.9rem 2rem;
    background: #e87722;
    color: white;
    border: none;
    border-radius: 12px;
    font-size: 1.05rem;
    font-weight: 600;
    cursor: pointer;
    width: 100%;
    justify-content: center;
    transition: background 0.15s;
  }

  .camera-btn:hover { background: #d06b1a; }

  #camera-hint { font-size: 0.8rem; color: #888; margin: 0; }

  #upload-divider {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    max-width: 340px;
    color: #bbb;
    font-size: 0.85rem;
  }

  #upload-divider::before,
  #upload-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: #e0e0e0;
  }

  .privacy-notice {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: #4a7c59;
    background: #edf7f0;
    border: 1px solid #c3e6cb;
    border-radius: 6px;
    padding: 0.45rem 0.7rem;
  }

  .upload-label {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 2rem 3rem;
    border: 2px dashed #ccc;
    border-radius: 12px;
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
    color: #555;
  }

  .upload-label:hover {
    border-color: #e87722;
    background: #fff8f5;
    color: #e87722;
  }

  .upload-label span { font-weight: 600; font-size: 1rem; }
  .upload-hint { font-size: 0.78rem; color: #888; font-weight: 400; }

  .upload-label input[type="file"] {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .error-message {
    color: #c0392b;
    background: #fdf0ee;
    border: 1px solid #f5c6c0;
    border-radius: 6px;
    padding: 0.5rem 0.75rem;
    font-size: 0.9rem;
  }
</style>
