---
// HistoryStrip renders the horizontal scrolling history of chosen candidates.
// Interactivity is wired in index.astro's <script> block.
---
<div id="history-strip" class="history-strip" role="list" aria-label="Candidate history">
  <!-- Entries injected dynamically by index.astro -->
</div>

<style>
  .history-strip {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    padding: 4px 2px;
    scrollbar-width: thin;
    scrollbar-color: #ccc transparent;
  }

  .history-strip::-webkit-scrollbar { height: 4px; }
  .history-strip::-webkit-scrollbar-thumb { background: #ccc; border-radius: 2px; }

  /* Individual entries are injected as .history-entry divs */
  :global(.history-entry) {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    border: 2px solid #ddd;
    border-radius: 6px;
    overflow: hidden;
    cursor: pointer;
    position: relative;
    transition: border-color 0.15s, opacity 0.15s;
    background: #f5f5f5;
  }

  :global(.history-entry:hover) {
    border-color: #999;
  }

  /* Active entry gets blue outline */
  :global(.history-entry--active) {
    border-color: #2563eb;
    box-shadow: 0 0 0 2px #93c5fd;
    cursor: default;
  }

  /* Forward (de-emphasised) entries after a revert */
  :global(.history-entry--forward) {
    opacity: 0.4;
  }

  :global(.history-entry canvas) {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }
</style>
