---
---
<div id="color-matrix-section" hidden>
  <h3>Color Matrix</h3>
  <p class="section-hint">Each cell shows the LEGO color name for that position.</p>
  <div id="color-matrix" class="color-matrix" role="table" aria-label="32 by 32 color matrix"></div>
</div>

<style>
  #color-matrix-section {
    padding: 1rem;
    max-width: 900px;
    margin: 0 auto;
  }

  h3 {
    font-size: 1rem;
    margin: 0 0 0.25rem;
  }

  .section-hint {
    font-size: 0.8rem;
    color: #888;
    margin: 0 0 0.75rem;
  }

  .color-matrix {
    display: grid;
    grid-template-columns: repeat(32, 1fr);
    border: 1px solid #ccc;
    border-radius: 6px;
    overflow: hidden;
    font-size: 5px;
    line-height: 1;
  }

  .matrix-cell {
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    color: rgba(0,0,0,0.5);
    font-size: 5px;
    padding: 1px;
  }
</style>
