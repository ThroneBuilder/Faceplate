    font-weight: 600;
    cursor: pointer;
    text-align: center;
    transition: background 0.15s, opacity 0.15s;
  }

  #camera-btn        { background: #e87722; color: white; }
  #camera-btn:hover  { background: #d06b1a; }

  .upload-btn        { background: #eee; color: #333; }
  .upload-btn:hover  { background: #ddd; }

  .upload-btn input[type="file"] {
    position: absolute;
    width: 1px; height: 1px;
