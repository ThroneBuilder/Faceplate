---
---
<div id="camera-viewfinder" hidden>
  <div class="viewfinder-container">
    <video id="camera-video" autoplay playsinline muted aria-label="Camera viewfinder"></video>
    <div id="camera-switch-row" hidden>
      <button id="switch-camera-btn" type="button" class="icon-btn" aria-label="Switch camera">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M20 7h-4l-2-3H10L8 7H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/>
          <circle cx="12" cy="13" r="3"/>
        </svg>
        Switch Camera
      </button>
    </div>
  </div>

  <p id="camera-notice" class="notice">Position your face in the frame, then tap Capture.</p>

  <div class="viewfinder-actions">
    <button id="capture-btn" type="button" class="capture-btn" aria-label="Take photo">
      <span class="capture-ring"></span>
    </button>
    <button id="cancel-camera-btn" type="button" class="secondary">Cancel</button>
  </div>
</div>

<style>
  #camera-viewfinder {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
  }

  .viewfinder-container {
    position: relative;
    width: 100%;
    max-width: 480px;
  }

  #camera-video {
    width: 100%;
    max-height: 360px;
    border-radius: 12px;
    background: #000;
    object-fit: cover;
    display: block;
  }

  #camera-switch-row {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
  }

  .icon-btn {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.75rem;
    border: none;
    border-radius: 20px;
    background: rgba(0,0,0,0.55);
    color: white;
    font-size: 0.8rem;
    cursor: pointer;
  }

  .icon-btn:hover { background: rgba(0,0,0,0.75); }

  .notice { font-size: 0.85rem; color: #666; text-align: center; margin: 0; }

  .viewfinder-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .capture-btn {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: white;
    border: 3px solid #e87722;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.1s;
  }

  .capture-btn:active { transform: scale(0.93); }

  .capture-ring {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #e87722;
    display: block;
  }

  .secondary {
    padding: 0.5rem 1rem;
    border: none;
    border-radius: 8px;
    background: #eee;
    color: #333;
    font-size: 0.9rem;
    cursor: pointer;
  }

  .secondary:hover { background: #ddd; }
</style>
